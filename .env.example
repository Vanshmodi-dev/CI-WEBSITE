# Commerce Insight — environment variables
# Copy to .env.local for development. NEVER commit .env or .env.local.
# Master Plan §19: no secret is ever prefixed NEXT_PUBLIC_.

# ---- Site ------------------------------------------------------------------
# Canonical origin. Used for metadataBase, sitemap.xml, robots.txt, OG URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- Reviews (Phase 5) -----------------------------------------------------
# Published payload URL from tp-reviews-engine. Read SERVER-SIDE only.
# The visitor's browser must never contact Google. (Master Plan §13)
# REVIEWS_PAYLOAD_URL=""

# ---- YouTube (Phase 5) -----------------------------------------------------
# Server-side only. Restrict the key to the YouTube Data API in Google Cloud.
# Use playlistItems.list (1 quota unit), never search.list (100). (§14)
# YOUTUBE_API_KEY=""
# YOUTUBE_CHANNEL_ID=""

# ---- Database (Phase 4) ----------------------------------------------------
# DATABASE_URL=""

# ---- Enquiry notifications (Phase 4) ---------------------------------------
# RESEND_API_KEY=""
# ENQUIRY_NOTIFICATION_TO=""

# ---- Admin auth (Phase 5) --------------------------------------------------
# AUTH_SECRET=""
