{
  "name": "commerce-insight-website",
  "version": "0.1.0",
  "private": true,
  "description": "Website for Commerce Insight, an exclusive institute for commerce education in Pratap Nagar, Jaipur. Built by TradyPerch.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "test": "node --test \"tests/*.test.ts\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "create-admin": "node scripts/create-admin.mjs",
    "db:test": "node scripts/test-db.mjs serve",
    "db:test:stop": "node scripts/test-db.mjs stop",
    "db:inspect": "node scripts/inspect-db.mjs",
    "verify:constraints": "node scripts/verify-constraints.mjs",
    "verify:e2e": "node scripts/verify-e2e.mjs",
    "verify:scale": "node scripts/scale-check.mjs",
    "verify:public": "node scripts/verify-public-isolation.mjs",
    "verify:revalidation": "node scripts/verify-revalidation.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "clsx": "2.1.1",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.2",
    "prisma": "^7.9.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true
  }
}
