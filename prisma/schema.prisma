// Commerce Insight — data model
// =============================================================================
// Master Plan §11. Deliberately small: only content that genuinely changes on a
// cadence, or that must be captured, gets a table.
//
// NOT IN HERE, ON PURPOSE:
//   - Reviews  → the TP Reviews Engine payload is the source of truth (§13).
//                Copying reviews here would fork it and bypass its publish gate.
//   - Videos   → REVERSED IN PHASE 16, TOPIC 9. This line used to read "YouTube
//                is already the database (§14)", and that stopped being true
//                when the institute needed to choose WHICH videos appear.
//                A channel feed has no editorial gate: every upload would
//                appear on the website automatically, which contradicts the
//                rule that nothing is public until somebody publishes it. The
//                `videos` table below stores a curated, validated YouTube ID
//                per row - never embed HTML, never a raw URL. See
//                docs/PHASE-16-TOPIC-9-VIDEOS-REPORT.md section 4.
//   - Courses  → design-bearing long-form content; lives in the repo (§11).
//   - Faculty  → same, and version control is the right audit trail for
//                credential claims.
//   - NAP      → src/config/institute.ts is the single source of truth (§17).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// ENQUIRIES — the only table that is unambiguously required.
// =============================================================================

enum EnquiryStatus {
  NEW
  CONTACTED
  ENROLLED
  CLOSED
  SPAM
}

enum ClassLevel {
  CLASS_11
  CLASS_12
  CA_FOUNDATION
  CA_INTERMEDIATE
  CMA
  OTHER
}

/// A lead from the public enquiry form.
///
/// PRIVACY: we store what is needed to call the person back, and nothing else.
/// The raw IP address is never persisted — `ipHash` is an HMAC-SHA256 keyed
/// with a server secret, which supports rate limiting and abuse investigation
/// without retaining an identifier we do not need.
model Enquiry {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ---- what the visitor submitted --------------------------------------
  name       String     @db.VarChar(80)
  /// Normalised to digits with a country code, e.g. "919509017150".
  phone      String     @db.VarChar(20)
  email      String?    @db.VarChar(160)
  classLevel ClassLevel
  /// Slug of the course the enquiry came from, when it came from one.
  courseSlug String?    @db.VarChar(64)
  message    String?    @db.VarChar(2000)

  // ---- attribution and handling ----------------------------------------
  /// Path only — never a full URL with query string, which could carry PII.
  sourcePage String        @db.VarChar(200)
  status     EnquiryStatus @default(NEW)
  /// Internal follow-up notes, written by staff in the admin (Phase 5).
  notes      String?       @db.VarChar(2000)

  // ---- consent and abuse control ---------------------------------------
  /// When the visitor submitted the form with the consent line displayed.
  consentAt DateTime
  /// HMAC-SHA256 of the client IP. NEVER the raw address.
  ///
  /// NULLABLE SINCE PHASE 10, and that is the point: the hash exists only to
  /// support the 24-hour rate-limit window. Once a lead is older than the
  /// retention window it serves no purpose, so `scripts/retention.mjs` clears
  /// it. Keeping a per-person identifier forever, for a check that only looks
  /// back a day, is data we cannot justify holding.
  ipHash    String?  @db.Char(64)

  // Rate limiting reads (ipHash, createdAt); the admin list reads
  // (status, createdAt); duplicate detection reads (phone, createdAt).
  @@index([ipHash, createdAt])
  @@index([status, createdAt])
  @@index([phone, createdAt])
  @@map("enquiries")
}

// =============================================================================
// STUDENT DATA — consent-gated. See docs/design/STUDENT-DATA-POLICY.md.
//
// Publication is assumed NOT authorised until a specific record says otherwise.
// `published` defaults to false everywhere, `displayNameMode` defaults to the
// most private option, and database CHECK constraints (added in the migration)
// make an unconsented published row impossible rather than merely discouraged.
// =============================================================================

// CONSENT IS FOUR INDEPENDENT PERMISSIONS, NOT A LADDER.
//
// This replaced an ordered `ConsentScope` enum. The enum could not express the
// rule the institute actually requires: that authorising a STORY must not also
// authorise a PHOTOGRAPH. An ordered scale forces every higher grant to imply
// every lower one, which is wrong for permissions that people grant separately
// on a paper form.
//
// Each flag answers one question, defaults to false, and is NOT NULL — so
// unlike a nullable enum these can never make a CHECK constraint evaluate to
// NULL, which is what made the old constraints quietly permissive
// (docs/PHASE-4.5-DB-VERIFICATION.md, Finding 3).
//
//   consentResult  may we publish the score at all?
//   consentName    may we show a name rather than initials?
//   consentPhoto   may we show a photograph?
//   consentStory   may we publish a written story about them?
//
// `consentRef` still points at the signed paperwork and is still required
// before anything is published.

enum DisplayNameMode {
  INITIALS
  FIRST_NAME_ONLY
  FULL
}

enum Programme {
  CLASS_11
  CLASS_12
  CA_FOUNDATION
  CA_INTERMEDIATE
  CMA
}

enum Board {
  CBSE
  RBSE
  ICAI
  OTHER
}

/// A highlighted achiever. Shown on the homepage band and /results.
model Topper {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Stored in full; what is DISPLAYED is governed by displayNameMode and
  /// consentScope, never by this field alone.
  studentName     String          @db.VarChar(120)
  displayNameMode DisplayNameMode @default(INITIALS)
  photoUrl        String?         @db.VarChar(500)

  score     Decimal   @db.Decimal(6, 2)
  /// "percent" or "marks".
  scoreUnit String    @db.VarChar(16)
  programme Programme
  board     Board?
  year      Int
  highlight String?   @db.VarChar(160)

  subjectScores SubjectScore[]

  // ---- publication control ---------------------------------------------
  /// Reference to the signed authorisation the institute holds on file.
  /// A published row cannot have this null — enforced by CHECK constraint.
  consentRef    String?   @db.VarChar(200)
  consentResult Boolean   @default(false)
  consentName   Boolean   @default(false)
  consentPhoto  Boolean   @default(false)
  published     Boolean   @default(false)
  publishedAt   DateTime?
  sortOrder     Int       @default(0)

  /// THE IMPORT KEY (Phase 12).
  ///
  /// The institute's own reference for this record - a roll number, an
  /// enrolment code, whatever their spreadsheet already uses. Supplied by the
  /// teacher, never generated here.
  ///
  /// WHY IT EXISTS. A spreadsheet import needs to know whether a row is a new
  /// record or a correction to one it created last week, and there is no safe
  /// way to answer that from the data alone. Names are not unique - Phase 8
  /// found two students sharing a name and a year colliding on a story slug -
  /// and matching on name plus programme plus year would turn a corrected
  /// spelling into a duplicate student.
  ///
  /// So the teacher owns the identity. Reuse a reference and that row is
  /// updated; use a new one and a record is added. Unique, so the same
  /// reference can never describe two records.
  ///
  /// Nullable because records created by hand in the admin have no spreadsheet
  /// row to point at, and must not be forced to invent one.
  importRef String? @unique @db.VarChar(64)

  @@index([published, year])
  @@index([programme, year])
  @@map("toppers")
}

/// One line of the full results table behind the toppers band.
model SubjectScore {
  id       String @id @default(cuid())
  topperId String
  topper   Topper @relation(fields: [topperId], references: [id], onDelete: Cascade)

  subject String  @db.VarChar(60)
  score   Decimal @db.Decimal(6, 2)

  @@index([topperId])
  @@map("subject_scores")
}

/// Owned editorial content — deeper than a Google review (Master Plan §18).
model StudentStory {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slug            String          @unique @db.VarChar(120)
  studentName     String          @db.VarChar(120)
  displayNameMode DisplayNameMode @default(INITIALS)
  photoUrl        String?         @db.VarChar(500)

  programme Programme
  year      Int

  challenge String  @db.VarChar(2000)
  journey   String  @db.VarChar(4000)
  outcome   String  @db.VarChar(2000)
  quote     String? @db.VarChar(600)

  consentRef   String?   @db.VarChar(200)
  consentStory Boolean   @default(false)
  consentName  Boolean   @default(false)
  consentPhoto Boolean   @default(false)
  published    Boolean   @default(false)
  publishedAt  DateTime?

  @@index([published, year])
  @@map("student_stories")
}

// =============================================================================
// ANNOUNCEMENTS AND BATCHES
// Both exist to kill the class of bug found in the old site: a date hardcoded
// into a component that silently went stale (Master Plan §00).
// =============================================================================

/// A time-boxed notice. The validity window means a stale notice removes
/// itself rather than advertising a batch that started two months ago.
model Announcement {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  message   String   @db.VarChar(300)
  href      String?  @db.VarChar(300)
  startsAt  DateTime
  endsAt    DateTime
  priority  Int      @default(0)
  published Boolean  @default(false)

  @@index([published, startsAt, endsAt])
  @@map("announcements")
}

/// Upcoming batch for a course. Course pages read the next published batch,
/// or show nothing at all.
model Batch {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courseSlug String   @db.VarChar(64)
  startsAt   DateTime
  /// "Offline", "Online live", "Offline + online live".
  mode       String   @db.VarChar(60)
  seatsNote  String?  @db.VarChar(120)
  published  Boolean  @default(false)

  @@index([courseSlug, published, startsAt])
  @@map("batches")
}

// =============================================================================
// ADMIN
// A single institute owner, plus a record of what was published and when.
// =============================================================================

/// An account that can sign in to /admin.
///
/// There is no self-registration and no password-reset flow: accounts are
/// seeded deliberately. One role only — see docs/PHASE-5-REPORT.md for why a
/// role column was not added yet.
model AdminUser {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email        String @unique @db.VarChar(160)
  /// Shown in the admin header. "Sir", a first name — whatever the owner wants.
  displayName  String @db.VarChar(80)
  /// scrypt, encoded as "scrypt$N$r$p$salt$hash". NEVER a plaintext password.
  passwordHash String @db.VarChar(255)

  lastLoginAt DateTime?
  /// Deactivating is preferred to deleting, so audit entries keep their actor.
  active      Boolean   @default(true)

  // ---- session revocation (Phase 10) -----------------------------------
  /// Sessions issued BEFORE this instant are refused.
  ///
  /// The session cookie is a signed bearer token with no server-side record, so
  /// without this there is nothing to revoke: clearing the cookie only affects
  /// the browser that asked. Phase 10 proved the consequence by capturing a
  /// token, signing out, and replaying it successfully. Logout now moves this
  /// forward, which invalidates every outstanding token for the account.
  sessionsValidFrom DateTime @default(now())

  // ---- sign-in throttling (Phase 10) -----------------------------------
  /// Consecutive failed sign-ins since the last success or window expiry.
  failedLoginCount   Int       @default(0)
  /// When the current run of failures began. The window is measured from here.
  firstFailedLoginAt DateTime?

  auditEntries AuditLog[]

  @@map("admin_users")
}

/// One spreadsheet import, recorded after the fact.
///
/// METADATA ONLY, NEVER THE FILE. The uploaded spreadsheet is parsed in memory
/// and discarded; what survives is the shape of what happened. Keeping the file
/// would mean keeping a second copy of every student's marks outside the
/// consent model and outside the retention policy, to answer a question the
/// counts below already answer.
///
/// `filename` is stored so the teacher can recognise their own upload. It is
/// sanitised on the way in - it is a label, not a path, and nothing ever opens
/// it.
model ImportRun {
  id String   @id @default(cuid())
  at DateTime @default(now())

  actorId    String?
  actorLabel String  @db.VarChar(80)

  /// Sanitised for display only. Never used as a path.
  filename   String @db.VarChar(160)
  /// SHA-256 of the normalised plan the administrator approved.
  planDigest String @db.Char(64)

  rowsTotal    Int
  rowsCreated  Int
  rowsUpdated  Int
  rowsRejected Int
  /// How many records this import made publicly visible. Usually zero.
  madePublic   Int @default(0)
  durationMs   Int

  @@index([at])
  @@map("import_runs")
}

/// Who published what, and when.
///
/// Deliberately records the SHAPE of an action, never its content: an entity
/// type and id, not a student's name or marks. Cheap now, and the only way to
/// answer "who published this student's photo?" in a dispute.
model AuditLog {
  id String   @id @default(cuid())
  at DateTime @default(now())

  actorId    String?
  actor      AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// Denormalised so the entry stays readable if the account is ever removed.
  actorLabel String     @db.VarChar(80)

  /// "created" | "updated" | "published" | "unpublished" | "deleted"
  action   String  @db.VarChar(30)
  /// "Topper" | "ResultRecord" | "StudentStory" | "Announcement" | "Batch" | "Enquiry"
  entity   String  @db.VarChar(40)
  entityId String  @db.VarChar(40)
  /// Short, human-readable, and free of personal data. Optional.
  summary  String? @db.VarChar(200)

  @@index([at])
  @@index([entity, entityId])
  @@map("audit_log")
}

/// Editable website copy, one row per named field.
///
/// A KEY/VALUE TABLE, DELIBERATELY. The alternative — a column per editable
/// field — means a migration every time the institute wants to change a
/// sentence, which is the thing this table exists to avoid. The usual cost of
/// key/value is that it accepts anything; that cost is paid off here by
/// `src/config/site-content.ts`, which declares the closed list of permitted
/// keys, and by CHECK constraints that bound the key charset and the value
/// length in the database itself.
///
/// A MISSING ROW IS NOT AN ERROR. Every key has a fallback in code, so an
/// empty table renders exactly the site that shipped. Deleting a row is the
/// undo.
model SiteSetting {
  key   String @id @db.VarChar(64)
  value String @db.VarChar(2000)

  updatedAt DateTime @updatedAt
  /// Denormalised: the entry must stay readable if the account is removed.
  updatedBy String?  @db.VarChar(80)

  @@map("site_settings")
}

/// One stored image.
///
/// WHY THIS TABLE IS GENUINELY REQUIRED, since the rule is to add none.
///
/// The bytes could live in storage alone — the record's `photoUrl` already
/// addresses them, and serving needs no database at all. Three requirements
/// make a row necessary anyway:
///
///   1. CHOOSING AN EXISTING IMAGE. The admin must be able to pick a photo
///      already uploaded rather than re-uploading it. Listing an object store
///      is slow, unpaginated and tells you nothing about what a file is.
///   2. ORPHAN RECONCILIATION. "Which stored files does nothing reference?" and
///      "which references point at a file that is gone?" are both unanswerable
///      without a manifest to compare storage against.
///   3. METADATA THE ADMIN SHOWS. Dimensions and size are read once at upload;
///      re-deriving them means decoding every image on every page render.
///
/// It deliberately does NOT hold consent, publication state, or any link to a
/// student. A media row is a file, not a permission — see the consent boundary
/// in docs/PHASE-16-TOPIC-5-MEDIA.md. Which record uses which photo stays in
/// that record's own `photoUrl`, under that record's own consent rules.
model MediaAsset {
  /// `<sha256 of the stored bytes, first 32 hex>.<ext>`. Content-addressed, so
  /// the same picture is always the same key and a different picture is always
  /// a different URL.
  key String @id @db.VarChar(40)

  contentType String @db.VarChar(40)
  width       Int
  height      Int
  bytes       Int

  /// The teacher's own filename, kept ONLY so they recognise their upload in a
  /// list. Never a path, never trusted, always escaped on render.
  originalName String @db.VarChar(160)

  uploadedAt DateTime @default(now())
  /// Denormalised so the row stays readable if the account is removed.
  uploadedBy String   @db.VarChar(80)

  @@index([uploadedAt])
  @@map("media_assets")
}

/// A member of teaching staff, as shown on /faculty.
///
/// ⚠ THIS REVERSES MASTER PLAN DECISION 03, DELIBERATELY AND ON INSTRUCTION.
///
/// That decision reads: "Content that changes gets a database. Content that
/// carries design stays in code. Results, toppers, announcements and enquiries
/// go to Postgres with an admin UI. Course and faculty pages stay typed content
/// in the repo, because a generic CMS shape would flatten exactly the layouts
/// that make this site feel bespoke."
///
/// The owner has since required faculty to be admin-managed, because the
/// alternative is that the institute cannot correct a teacher's name without a
/// developer. The reversal keeps the REASONING of Decision 03 intact by
/// splitting it where the decision itself did not: the DATA lives here, and the
/// DESIGN stays a typed React component. There is no layout field, no HTML
/// field, no colour, no ordering of sections - nothing a CMS could use to
/// flatten the page.
///
/// WHAT IS DELIBERATELY ABSENT.
///
/// No phone, no email, no address: the brief forbids storing personal contact
/// details for staff, and the site has no use for them. No qualifications,
/// experience or achievements either - the master directive says "only publish
/// verified information", none is supplied, and a text box invites somebody to
/// fill it with a claim nobody checked.
///
/// CONSENT. `docs/design/STUDENT-DATA-POLICY.md` is scoped to students and says
/// nothing about staff, so no consent COLUMN is modelled here - inventing one
/// would be inventing a policy. What IS guaranteed technically is that nothing
/// is public until somebody deliberately publishes it: `published` defaults to
/// false, exactly as it does for every other record on this site. Whether the
/// institute holds each teacher's permission is a human decision, recorded in
/// docs/PHASE-16-TOPIC-6-FACULTY.md and surfaced in the admin as a reminder,
/// not asserted here as law.
model Faculty {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name        String  @db.VarChar(120)
  /// "Position" in the master directive: Director, Senior Faculty, and so on.
  designation String  @db.VarChar(120)
  /// Subject or specialisation. Optional: not everyone teaches one subject.
  subject     String? @db.VarChar(120)
  /// A short description. Deliberately short - a card, not a biography page.
  bio         String? @db.VarChar(600)
  /// A site-relative path produced by the Topic 5 media pipeline, or null.
  photoUrl    String? @db.VarChar(500)

  /// Higher sorts first, matching the announcements convention. Ties break on
  /// name, so the public order is always total and never flickers.
  priority  Int     @default(0)
  /// Nothing is public until somebody publishes it. Never defaults to true.
  published Boolean @default(false)

  @@index([published, priority])
  @@map("faculty")
}

/// The categories the master directive names, minus the ones that are a UI
/// filter rather than a property of a photograph.
///
/// "All" is not here: it is the absence of a filter, not a category a
/// photograph can belong to. The remaining six are exactly the list in
/// `docs/brief/01-master-directive.md` section 22, which also says "only use
/// categories that correspond to real content" - so the PUBLIC page renders a
/// filter only for categories that actually have published photographs in them.
/// Storing the full set and displaying the populated subset satisfies both
/// halves of that instruction without inventing a category or hiding one.
///
/// A closed enum rather than free text. A text field would accumulate
/// "Classroom", "classrooms" and "Class rooms" within a month, and the public
/// filter would then advertise three categories that are one category.
enum GalleryCategory {
  CLASSROOMS
  EVENTS
  STUDENTS
  ACHIEVEMENTS
  SEMINARS
  CELEBRATIONS
}

/// One photograph in the institute gallery.
///
/// =============================================================================
/// THIS MODEL IS COVERED BY THE STUDENT DATA POLICY, AND THAT IS THE WHOLE
/// DESIGN
/// =============================================================================
/// `docs/design/STUDENT-DATA-POLICY.md` line 4 names its scope: "toppers,
/// results, student stories, **gallery photographs**". So a row here is not a
/// decorative asset - it is potentially a photograph of a minor, published,
/// permanent and indexable.
///
/// The policy's stated design position is "assume publication is NOT authorised
/// until a specific record says otherwise", and that is implemented here three
/// times over: in the save action, in a CHECK constraint below, and again on the
/// read path. Each protects against a different writer.
///
/// =============================================================================
/// WHY THE CONSENT COLUMNS ARE NOT THE STUDENT COLUMNS
/// =============================================================================
/// `Topper` and `StudentStory` carry `studentName` and `displayNameMode`,
/// because each row is ABOUT one identified student and the question is how much
/// of them to show. A photograph is not about one student: a picture of a
/// prize-giving may contain thirty, or none.
///
/// So `blockersForPublishing()` in src/lib/student-display.ts cannot be reused -
/// it needs a name and a display mode that do not exist here. What IS reused is
/// the POLICY: a photograph needs its own permission, that permission is never
/// implied by anything else, and a published record cannot have a null
/// `consentRef`. `galleryBlockers()` applies exactly those rules to the shape
/// this model actually has.
///
/// =============================================================================
/// `showsPeople` DEFAULTS TO TRUE, AND THE DEFAULT IS THE POINT
/// =============================================================================
/// A photograph of an empty classroom needs no student's permission, and
/// demanding a consent reference for a picture of furniture would be inventing
/// policy in the opposite direction. But the safe default when nobody has said
/// either way is that there ARE people in it - so the teacher must deliberately
/// declare a photograph people-free to publish it without a consent reference,
/// rather than deliberately declare it sensitive to protect it.
///
/// Fail closed means the unset state is the protected state.
model GalleryItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// A site-relative path produced by the Topic 5 media pipeline.
  /// NOT NULLABLE: a gallery entry with no photograph is not a gallery entry.
  /// This is the one photo field on the site that is genuinely required, and
  /// the admin says so in words rather than discovering it at save time.
  imageUrl String @db.VarChar(500)

  /// What the photograph shows, for somebody who cannot see it. Required,
  /// because an image-only page with no alt text is unusable with a screen
  /// reader and there is no sensible fallback to compute.
  alt String @db.VarChar(200)

  /// An optional editorial line under the photograph. The brief asks for
  /// "stories through visuals" rather than a wall of images, and this is the
  /// only field that carries the story.
  caption String? @db.VarChar(300)

  category GalleryCategory

  /// Higher sorts first, matching faculty and announcements. Ties break on
  /// createdAt so the public order is total and never flickers.
  priority Int @default(0)

  /// Nothing is public until somebody publishes it. Never defaults to true.
  published Boolean @default(false)

  /// Does this photograph show identifiable people? Conservative default.
  showsPeople Boolean @default(true)

  /// Reference to the signed authorisation the institute holds on file.
  /// A published photograph of people cannot have this null - CHECK constraint.
  consentRef String? @db.VarChar(200)

  /// Permission to publish a photograph. Never implied by anything else -
  /// STUDENT-DATA-POLICY, "The four permissions".
  consentPhoto Boolean @default(false)

  @@index([published, priority])
  @@index([published, category])
  @@map("gallery_items")
}


/// The subjects a video can be filed under.
///
/// Taken from `docs/brief/01-master-directive.md` section 20, which lists
/// "Accounts, Economics, Business Studies, Exam Preparation" and then adds the
/// rule that matters: "only create categories supported by actual content". So
/// the enum is the closed set and the PUBLIC page renders a filter only for
/// subjects that actually have published videos in them - the same treatment
/// gallery categories get.
///
/// `OTHER` exists because a coaching institute posts things that are none of
/// the four - an admissions explainer, a results announcement - and forcing
/// those into "Exam preparation" would make the filter lie.
enum VideoSubject {
  ACCOUNTANCY
  BUSINESS_STUDIES
  ECONOMICS
  EXAM_PREPARATION
  OTHER
}

/// One YouTube video the institute has chosen to show on the website.
///
/// =============================================================================
/// WHAT IS STORED IS AN IDENTIFIER, NOT AN EMBED
/// =============================================================================
/// `youtubeId` is eleven characters of YouTube's own alphabet and nothing else.
/// It is not a URL, not an iframe, not embed HTML, and not a provider blob.
///
/// That is the whole security design. A teacher pastes a URL; the server parses
/// it, extracts the id, and throws the rest away - including any tracking
/// parameters, playlist references, timestamps and redirect chains that came
/// with it. Everything the browser is later asked to load is built from that id
/// by our own code, so there is no attacker-controlled URL anywhere in the
/// rendering path and nothing for an attacker to point an iframe at.
///
/// =============================================================================
/// NOTHING IS FETCHED FROM A SUBMITTED URL, SERVER-SIDE OR OTHERWISE
/// =============================================================================
/// The application never issues a request to a URL a teacher typed. Titles and
/// descriptions are typed by the teacher, not scraped; the thumbnail is
/// constructed from the id and fetched BY THE VISITOR'S BROWSER from
/// `i.ytimg.com`, which the CSP already permits.
///
/// So there is no SSRF surface here at all - not a mitigated one, an absent
/// one. That is a deliberate architectural choice and the main reason the
/// YouTube Data API route was not taken.
///
/// =============================================================================
/// CONSENT
/// =============================================================================
/// `docs/design/STUDENT-DATA-POLICY.md` scopes itself to "toppers, results,
/// student stories, gallery photographs". Videos are not named, so no consent
/// COLUMN is modelled here - inventing one would be inventing a policy, exactly
/// as Topic 6 declined to invent one for staff.
///
/// What IS different from a gallery photograph, and worth stating: the
/// institute has already published this video publicly on YouTube itself.
/// Embedding it does not make it more public than the institute already made
/// it. Whether a given video should have been published at all is a decision
/// that happened on YouTube, before this table saw it.
///
/// That is recorded as a HUMAN DECISION in the Topic 9 report rather than
/// settled here. What is guaranteed technically is the same guarantee
/// everything else on this site has: `published` defaults to false and nothing
/// appears until somebody deliberately publishes it.
model Video {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Eleven characters of `[A-Za-z0-9_-]`. Unique, so the same video cannot be
  /// added twice and quietly appear twice on the page.
  youtubeId String @unique @db.VarChar(16)

  /// The teacher's own title, not YouTube's.
  ///
  /// Deliberately OUR copy rather than a fetched one: a title on YouTube can be
  /// edited by whoever runs the channel at any time, and a website that mirrors
  /// it inherits that change without anybody deciding. Typing it also lets the
  /// institute write for a website reader rather than for a YouTube thumbnail.
  title String @db.VarChar(160)

  /// One or two sentences under the title. Optional, and optional means the
  /// save succeeds with it empty.
  description String? @db.VarChar(400)

  subject VideoSubject

  /// Higher sorts first, matching faculty, gallery and announcements. Ties
  /// break on `createdAt` descending, which for a curated list is "most
  /// recently added first" - the Master Plan's "latest first".
  ///
  /// THERE IS DELIBERATELY NO PUBLICATION-DATE FIELD. The real date lives on
  /// YouTube and is not available without the API; a hand-typed copy of it is a
  /// number nobody maintains, which is precisely the failure Master Plan
  /// section 00 names - a date hardcoded into a component that silently went
  /// stale.
  priority Int @default(0)

  /// Nothing is public until somebody publishes it. Never defaults to true.
  published Boolean @default(false)

  @@index([published, priority])
  @@index([published, subject])
  @@map("videos")
}
