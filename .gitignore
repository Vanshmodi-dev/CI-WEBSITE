# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/versions

# next.js
.next/
out/
build/
dist/
next-env.d.ts

# production
*.tsbuildinfo

# env — NEVER commit these (Master Plan §19)
.env
.env.*
!.env.example

# database
prisma/*.db
prisma/*.db-journal

# testing / reports
coverage/
.nyc_output/
playwright-report/
test-results/
.lighthouseci/

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# vercel
.vercel

# python (used only for brand-colour tooling)
__pycache__/
*.pyc
venv/
.venv/

# prisma - generated client. Recreated by the postinstall script, so it is
# never stale and never pollutes a diff.
/src/generated/

# local verification database (scripts/test-db.mjs) - never production data
.tmp-pgdata/

# preflight scorecard output (scripts/verify-preflight.mjs --json=...). It is a
# snapshot of one environment at one moment, so committing it would put a stale
# verdict in the repository next to the tool that produces a live one.
preflight.json
preflight-*.json

# uploaded media (development only)
# The local MediaStore adapter writes here. It is NOT production storage - the
# deployment target has an ephemeral filesystem. See
# docs/PHASE-16-TOPIC-5-MEDIA.md. Never commit uploaded photographs.
.media-store/
